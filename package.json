{
	"name": "@davidsabine/cfd-tutorial",
	"version": "1.0.1",
	"description": "Browser embed of the cumulative flow diagram teaching tool.",
	"license": "UNLICENSED",
	"author": "David Sabine",
	"homepage": "https://davesabine.com/cfd-tutorial/demo",
	"type": "module",
	"sideEffects": true,
	"main": "./dist/cfd-tutorial-1.0.1.js",
	"browser": "./dist/cfd-tutorial-1.0.1.js",
	"exports": {
		".": "./dist/cfd-tutorial-1.0.1.js"
	},
	"files": [
		"dist/cfd-tutorial-*.js"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"packageManager": "pnpm@11.1.1",
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"test": "vitest --reporter dot --project=unit --watch",
		"test:unit:run": "vitest --project=unit --run",
		"test:e2e:run": "playwright test",
		"build": "node scripts/build-bundle.mjs",
		"watch": "node scripts/build-bundle.mjs --watch",
		"done": "pnpm lint && pnpm typecheck && pnpm test:unit:run && pnpm build && pnpm test:e2e:run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.63.0",
		"@types/node": "26.6.4",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	}
}
